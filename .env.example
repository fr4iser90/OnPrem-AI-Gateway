# Required
DOMAIN=example.com
SESSION_SECRET=replace-with-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=replace-me
ADMIN_BOOTSTRAP_USER=admin

# Automatic — do NOT set unless compose runs without a login shell (cron/CI).
# compose.yaml passes your shell $UID / $GID → PUID / PGID (was: user: "${UID}:${GID}").

# Session cookie Secure flag: omit for local http://localhost (auto).
# Set PUBLIC_HOST=ai.example.com (Traefik) or SESSION_COOKIE_SECURE=true for HTTPS-only cookies.

# Public hostname (Traefik + nginx server_name). Subdomain for compose.traefik.yaml labels.
# Local compose: leave PUBLIC_HOST empty → http://localhost:9081/v1
PUBLIC_SUBDOMAIN=ai
PUBLIC_HOST=ai.example.com

# Only for local compose.yaml (published host ports). Not used behind Traefik /
# a reverse proxy — there you hit https://ai.${DOMAIN}/v1/..., no :9080/:9081.
# WEB_PORT=9080
# ONPREM_API_PORT=9081

# Optional: seed named sources into SQLite on first start only (empty DB).
# After that, manage sources in Admin → Services. Env vars are ignored once any source exists.
# CHAT_SOURCE=192.168.1.10:11535
# CHAT2_SOURCE=192.168.1.10:11435
# EMBED_SOURCE=192.168.1.10:11536
# EXTRACTOR_SOURCE=192.168.1.10:11539
# STT_SOURCE=192.168.1.10:9000
# TTS_SOURCE=192.168.1.10:9001

# Optional thermal guard threshold for the source-sidecar.
TEMP_MAX_C=85
TEMP_SENSOR_NAME=amdgpu
TEMP_SENSOR_LABEL=edge

# If sidecar is unreachable or returns an unexpected status:
# - true  → fail-open (allow traffic)
# - false → fail-closed (reject traffic)
TEMP_GUARD_FAIL_OPEN=true

# OnPrem AI Gateway + integration reports automatically use the source-sidecar on
# each source host: http://<source-host>:9105/power and /check.
# Deploy on the GPU/source host: docker compose -f services/source-sidecar/compose.yaml up -d --build
# GPU_POWER_URL=
# SOURCE_SIDECAR_PORT=9105

# Impressum for /legal/* (this install). Used when the Settings form field is empty.
# OPERATOR_NAME=Your Name
# OPERATOR_ADDRESS=Street 1, 00000 City
# OPERATOR_EMAIL=support@example.com
# OPERATOR_PHONE=
